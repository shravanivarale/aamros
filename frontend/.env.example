# ─────────────────────────────────────────────────────────────────────────────
# AAMROS Frontend — Environment Variables (Vite)
# Copy this file to .env and fill in your real values.
# NEVER commit .env with real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Authentication (Client-Side) ─────────────────────────────────────
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
# https://console.firebase.google.com
VITE_FIREBASE_API_KEY=AIzaSy...your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890

# ── Backend API URL (only needed for production builds) ───────────────────────
# In production on Vercel, the frontend is served from the same domain as the
# backend API, so /api/v1 requests are proxied automatically.
# Only set this if deploying frontend and backend on separate domains.
# VITE_API_BASE_URL=https://your-backend.vercel.app
