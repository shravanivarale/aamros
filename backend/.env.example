# ─────────────────────────────────────────────────────────────────────────────
# ARMS / AAMROS Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Supabase (PostgreSQL Database) ────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/database
#
# Option A – Direct connection (preferred for long-running servers)
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Option B – Transaction Pooler (required for serverless / Vercel)
# SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Use the pooler (port 6543) URL for Vercel deployments:
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase project URL and anon key (for Supabase client SDK, optional)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── Firebase Authentication ────────────────────────────────────────────────────
# The backend validates Firebase ID tokens using Google's JWKS endpoint.
# Only the project ID is needed for server-side validation.
# Get this from: https://console.firebase.google.com → Project settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Dashboard assistant ──────────────────────────────────────────────────────
# Keep this secret on the backend. Never expose it in frontend/.env.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
# In production, replace * with your real frontend URL:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# ── ROS 2 Robot Bridge (optional) ─────────────────────────────────────────────
# IP and port of the on-premise ROS bridge server
# Leave default if running simulated mode without a physical robot
# The armsbot_nav wms_bridge runs on the PC that runs the robot stack (default port 8005).
# Only seeds the FIRST robot PC on a fresh install; add/remove more in the dashboard (Settings -> Robot bridges).
ROS_BRIDGE_URL=http://10.113.140.148:8005

# ── Redis (optional — used for pub/sub, not required for core features) ────────
# Omit or leave empty to disable Redis-based features
# REDIS_URL=redis://localhost:6379/0
